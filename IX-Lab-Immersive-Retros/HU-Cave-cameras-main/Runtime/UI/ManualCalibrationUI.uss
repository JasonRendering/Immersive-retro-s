.panel-root {
    flex-grow: 1;
    width: 20%;
    background-color: rgb(30, 32, 37);
    padding: 10px;
}

.section-foldout {
    background-color: rgb(42, 45, 53);
    border-radius: 6px;
    padding: 6px;
    margin-bottom: 10px;
}

.section-hint {
    color: rgb(155, 160, 170);
    font-size: 10px;
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 14px;
}

.field-vector {
    flex-direction: column;
    margin-bottom: 8px;
}

.field-float {
    margin-bottom: 10px;
}

.btn-action {
    height: 30px;
    background-color: rgb(58, 110, 165);
    color: rgb(220, 230, 245);
    border-width: 0;
    border-radius: 5px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    transition-property: background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease;
}

.btn-action:hover {
    background-color: rgb(78, 136, 198);
}

.btn-action:active {
    background-color: rgb(40, 84, 136);
}

.btn-save {
    height: 32px;
    background-color: rgb(58, 145, 82);
    color: rgb(215, 245, 220);
    border-width: 0;
    border-radius: 5px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    transition-property: background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease;
}

.btn-save:hover {
    background-color: rgb(72, 168, 98);
}

.btn-save:active {
    background-color: rgb(42, 115, 62);
}

.btn-direction {
    height: 32px;
    background-color: rgb(200, 155, 50);
    color: rgb(18, 18, 22);
    border-width: 0;
    border-radius: 5px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    transition-property: background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease;
}

.btn-direction:hover {
    background-color: rgb(225, 178, 70);
}

.btn-direction:active {
    background-color: rgb(162, 122, 28);
}

.btn-direction-wide {
    width: 114px;
}

.btn-direction-side {
    width: 80px;
}

.compass-rose {
    align-items: center;
    margin-bottom: 12px;
}

.compass-top {
    margin-bottom: 5px;
}

.compass-middle {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.compass-center {
    width: 46px;
    height: 46px;
    border-radius: 23px;
    background-color: rgb(30, 32, 37);
    border-width: 2px;
    border-color: rgb(200, 155, 50);
    align-items: center;
    justify-content: center;
    margin-left: 5px;
    margin-right: 5px;
    transition-property: border-color;
    transition-duration: 0.15s;
    transition-timing-function: ease;
}

.compass-center:hover {
    border-color: rgb(225, 178, 70);
}

.compass-center-label {
    color: rgb(200, 155, 50);
    font-size: 9px;
    -unity-font-style: bold;
    transition-property: color;
    transition-duration: 0.15s;
    transition-timing-function: ease;
}

.compass-center:hover .compass-center-label {
    color: rgb(225, 178, 70);
}

.unity-text-element {
    color: rgb(224, 224, 224);
}

.unity-text-element__selectable {
    color: rgb(18, 18, 22);
}
